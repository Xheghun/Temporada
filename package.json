{
  "name": "seasonal-worker-mobile",
  "license": "UNLICENSED",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "@testing-library/react-native": "^14.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc --project mock-server/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "jest --ci --runInBand && node --test scripts/check-architecture.test.mjs && npm run test:mock",
    "arch:check": "node scripts/check-architecture.mjs",
    "expo:check": "expo install --check",
    "config:check": "expo config --type public",
    "mock:start": "npm start --prefix mock-server",
    "test:mock": "npm test --prefix mock-server"
  },
  "private": true,
  "engines": {
    "node": "^24.3.0"
  }
}
