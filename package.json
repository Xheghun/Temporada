  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.23",
    "expo-blob": "^58.0.3",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit && tsc --project mock-server/tsconfig.json && tsc --project testing/persistence/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "jest --ci --runInBand && node --test scripts/check-architecture.test.mjs && npm run test:mock && npm run test:persistence",
    "arch:check": "node scripts/check-architecture.mjs",
    "expo:check": "expo install --check",
    "config:check": "expo config --type public",
    "mock:start": "npm start --prefix mock-server",
    "test:mock": "npm test --prefix mock-server",
    "test:persistence": "node --experimental-strip-types --test testing/persistence/*.test.mts"
  },
  "private": true,
  "engines": {
    "node": "^24.3.0"
  }
}
