{
  "expo": {
    "name": "Trabajador",
    "slug": "seasonal-worker-mobile",
    "version": "0.1.0",
    "scheme": "seasonal-worker",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cremedigital.seasonalworker"
    },
    "android": {
      "package": "com.cremedigital.seasonalworker"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
