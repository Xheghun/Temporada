# Public configuration is bundled into the application. Never put secrets here.
# Set only when the mock-api change is implemented; no production default.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Development only; production also requires an approved remote flag and HTTPS API.
# EXPO_PUBLIC_ASSESSMENT_MODE=1
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# EXPO_PUBLIC_FLAGS_URL=https://your-config-service.example/worker-flags
